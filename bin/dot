#!/usr/bin/env bash

set -euo pipefail

##? The dotfiles CLI
#?? 1.0.0
##?
##? Usage:
##?    dot [<namespace>] <command> [<args>...]
##?    dot -h | --help
##?    dot --version
##?
##? Namespaces:
##?    self             Dotfiles lifecycle (bootstrap, update)
##?    packages         System package management
##?    git              Git configuration
##?    doc              Reference guides
##?    claude           Claude Code agent pack management

export DOTFILES_PATH
DOTFILES_PATH="$(cd "$(dirname "$0")/.." && pwd)"

source "$DOTFILES_PATH/scripts/_core/_main.sh"

# Separate positional args from flags
args=()
show_help=false
show_version=false

for arg in "$@"; do
  case "$arg" in
    -h|--help) show_help=true ;;
    --version) show_version=true ;;
    *) args+=("$arg") ;;
  esac
done

namespace="${args[0]:-}"
command="${args[1]:-}"

# Resolve help/version target: command > namespace > dot
if $show_help || $show_version; then
  if [[ -n "$namespace" && -n "$command" && -f "$DOTFILES_PATH/scripts/$namespace/bin/$command" ]]; then
    target="$DOTFILES_PATH/scripts/$namespace/bin/$command"
  elif [[ -n "$namespace" && -f "$DOTFILES_PATH/scripts/$namespace/_namespace.sh" ]]; then
    target="$DOTFILES_PATH/scripts/$namespace/_namespace.sh"
  else
    target="$0"
  fi

  if $show_help; then extract_help "$target"; fi
  if $show_version; then _compose_version "$target"; fi
  exit 0
fi

# Default to "self" namespace when only a command is given
if [[ -n "$namespace" && -z "$command" && -f "$DOTFILES_PATH/scripts/self/bin/$namespace" ]]; then
  command="$namespace"
  namespace="self"
elif [[ -n "$namespace" && -z "$command" && -f "$DOTFILES_PATH/scripts/$namespace/_namespace.sh" ]]; then
  extract_help "$DOTFILES_PATH/scripts/$namespace/_namespace.sh"
  exit 0
elif [[ -n "$namespace" && -n "$command" ]]; then
  shift 2 2>/dev/null || true
else
  extract_help "$0"
  exit 1
fi

script="$DOTFILES_PATH/scripts/$namespace/bin/$command"

if [[ ! -f "$script" ]]; then
  log::error "Unknown command: dot $namespace $command"
  exit 1
fi

exec "$script" "$@"
