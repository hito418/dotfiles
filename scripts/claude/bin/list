#!/usr/bin/env bash

set -euo pipefail

source "$DOTFILES_PATH/scripts/_core/_main.sh"
source "$DOTFILES_PATH/scripts/claude/packs.sh"

##? Show available packs and installed agents in current project
##?
##? Usage:
##?    dot claude list

docs::eval_help_first_arg "${@:1}"

log::header "Available packs"
packs::list_available

echo ""
log::header "Installed agents"
packs::list_installed "$(pwd)/.claude/agents"
