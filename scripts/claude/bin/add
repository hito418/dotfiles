#!/usr/bin/env bash

set -euo pipefail

source "$DOTFILES_PATH/scripts/_core/_main.sh"
source "$DOTFILES_PATH/scripts/claude/packs.sh"

##? Symlink pack agents into the current project's .claude/agents/
##?
##? Usage:
##?    dot claude add <packs>...
##?
##? Examples:
##?    dot claude add fullstack react
##?    dot claude add fullstack,react

docs::eval_help_first_arg "${@:1}"

if [[ $# -eq 0 ]]; then
    log::error "Usage: dot claude add <packs>..."
    exit 1
fi

if [[ ! -d ".git" ]]; then
    log::error "Not a git repository. Run this from a project root."
    exit 1
fi

target_dir="$(pwd)/.claude/agents"

while IFS= read -r pack; do
    conf=$(packs::resolve "$pack") || exit 1
    log::note "Installing pack: $pack"
    packs::install "$target_dir" "$conf"
done <<< "$(packs::parse_names "$@")"
