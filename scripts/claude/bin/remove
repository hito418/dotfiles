#!/usr/bin/env bash

set -euo pipefail

source "$DOTFILES_PATH/scripts/_core/_main.sh"
source "$DOTFILES_PATH/scripts/claude/packs.sh"

##? Remove pack agent symlinks from the current project
##?
##? Usage:
##?    dot claude remove <packs>...
##?
##? Examples:
##?    dot claude remove react
##?    dot claude remove fullstack,react

docs::eval_help_first_arg "${@:1}"

if [[ $# -eq 0 ]]; then
    log::error "Usage: dot claude remove <packs>..."
    exit 1
fi

target_dir="$(pwd)/.claude/agents"

if [[ ! -d "$target_dir" ]]; then
    log::note "No agents installed in this project"
    exit 0
fi

while IFS= read -r pack; do
    conf=$(packs::resolve "$pack") || exit 1
    log::note "Removing pack: $pack"
    packs::uninstall "$target_dir" "$conf"
done <<< "$(packs::parse_names "$@")"
