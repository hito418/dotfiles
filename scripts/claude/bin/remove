#!/usr/bin/env bash

set -euo pipefail

source "$DOTFILES_PATH/scripts/_core/_main.sh"
source "$DOTFILES_PATH/scripts/claude/packs.sh"

##? Remove Claude rules, skills and/or agent pack symlinks from ~/.claude (or a project)
##?
##? Usage:
##?    dot claude remove [--project] <names>...
##?
##? Names:
##?    rules            Remove the rules symlink
##?    skills           Remove the skills symlink
##?    <pack>           Remove an agent pack
##?
##? Options:
##?    --project        Target current project's .claude/ (default: ~/.claude)
##?
##? Examples:
##?    dot claude remove react
##?    dot claude remove --project rules,skills,fullstack

docs::eval_help_first_arg "${@:1}"

scope="global"
names=()
for arg in "$@"; do
    case "$arg" in
        --project|--local) scope="project" ;;
        -*) log::error "Unknown option: $arg"; exit 1 ;;
        *) names+=("$arg") ;;
    esac
done

if [[ ${#names[@]} -eq 0 ]]; then
    log::error "Usage: dot claude remove [--project] <names>..."
    exit 1
fi

target_base="$(packs::resolve_target "$scope")"

if [[ ! -d "$target_base" ]]; then
    log::note "No .claude directory at $target_base"
    exit 0
fi

while IFS= read -r name; do
    if packs::is_resource "$name"; then
        packs::uninstall_resource "$name" "$target_base"
    else
        conf=$(packs::resolve "$name") || exit 1
        log::note "Removing pack: $name"
        packs::uninstall "$target_base/agents" "$conf"
    fi
done <<< "$(packs::parse_names "${names[@]}")"
