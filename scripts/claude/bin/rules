#!/usr/bin/env bash

set -euo pipefail

source "$DOTFILES_PATH/scripts/_core/_main.sh"
source "$DOTFILES_PATH/scripts/claude/_common.sh"
source "$DOTFILES_PATH/scripts/claude/rules.sh"

##? Manage Claude Code rules (per-rule symlinks)
##?
##? Usage:
##?    dot claude rules add [--project] <rule>...
##?    dot claude rules remove [--project] <rule>...
##?    dot claude rules list [--project]
##?
##? Options:
##?    --project        Target current project's .claude/ (default: ~/.claude)
##?
##? Examples:
##?    dot claude rules add git process
##?    dot claude rules add --project code-style
##?    dot claude rules list

docs::eval_help_first_arg "${@:1}"

verb="${1:-}"
shift 2>/dev/null || true

scope="global"
names=()
for arg in "$@"; do
    case "$arg" in
        --project|--local) scope="project" ;;
        -*) log::error "Unknown option: $arg"; exit 1 ;;
        *) names+=("$arg") ;;
    esac
done

target_base="$(claude::resolve_target "$scope")"

case "$verb" in
    add)
        if [[ ${#names[@]} -eq 0 ]]; then
            log::error "Usage: dot claude rules add [--project] <rule>..."
            exit 1
        fi
        mkdir -p "$target_base"
        while IFS= read -r name; do
            rules::install "$name" "$target_base" || exit 1
        done <<< "$(claude::parse_names "${names[@]}")"
        ;;
    remove)
        if [[ ${#names[@]} -eq 0 ]]; then
            log::error "Usage: dot claude rules remove [--project] <rule>..."
            exit 1
        fi
        if [[ ! -d "$target_base" ]]; then
            log::note "No .claude at $target_base"
            exit 0
        fi
        while IFS= read -r name; do
            rules::uninstall "$name" "$target_base"
        done <<< "$(claude::parse_names "${names[@]}")"
        ;;
    list)
        log::header "Available rules"
        rules::list_available
        echo ""
        log::header "Installed at $target_base"
        rules::list_installed "$target_base"
        ;;
    *)
        log::error "Usage: dot claude rules {add|remove|list} [--project] [<rule>...]"
        exit 1
        ;;
esac
