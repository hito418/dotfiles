#!/usr/bin/env bash

set -euo pipefail

source "$DOTFILES_PATH/scripts/core/_main.sh"

##? GPG Signing for Git
##?
##? 1. Generate a new GPG key:
##?
##?    gpg --full-generate-key
##?
##?    Select: RSA and RSA, 4096 bits, no expiration (or your preference).
##?    Use the same email as your git config.
##?
##? 2. Find your key ID:
##?
##?    gpg --list-secret-keys --keyid-format=long
##?
##?    Look for the ID after "sec rsa4096/" — e.g. 3AA5C34371567BD2.
##?
##? 3. Run the setup command and paste the key ID when prompted:
##?
##?    dot git setup
##?
##? 4. Export your public key for GitHub / GitLab:
##?
##?    gpg --armor --export <key-id>
##?
##?    Add the output under Settings > SSH and GPG keys.

extract_help "$0"
