#!/usr/bin/env bash

set -euo pipefail

source "$DOTFILES_PATH/scripts/core/_main.sh"
source "$DOTFILES_PATH/scripts/self/git.sh"
source "$DOTFILES_PATH/scripts/self/symlinks.sh"
source "$DOTFILES_PATH/scripts/self/shell.sh"

##? Update dotfiles, packages, and symlinks

log::note "Updating dotfiles"
self_update

log::note "Installing system packages"
"$DOTFILES_PATH/bin/dot" packages install

if has_submodules; then
  log::note "Updating submodules"
  update_submodules
fi

log::note "Applying symlinks"
apply_common_symlinks

log::success "Dotfiles updated!"
