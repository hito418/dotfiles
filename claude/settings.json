{
    "$schema": "https://json.schemastore.org/claude-code-settings.json",
    "env": {
        "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
    },
    "permissions": {
        "allow": [
            "Bash(git add *)",
            "Bash(ls *)",
            "Bash(cat *)",
            "Bash(find *)",
            "Bash(grep *)",
            "Bash(which *)",
            "Bash(echo *)",
            "Bash(tail *)",
            "Bash(head *)",
            "WebFetch",
        ],
        "deny": [
            "Read(*.env)",
            "Read(./secrets/**)",
            "Bash(cat *.env)",
            "Bash(cat *secrets*)",
            "Bash(npm run *)"
        ],
        "ask": [
            "Bash(gh pr create:*)",
            "Bash(git commit:*)",
            "Bash(git * main)",
            "Bash(git push *)"
        ],
        "defaultMode": "default"
    },
    "statusLine": {
        "type": "command",
        "command": "~/.claude/statusline.sh"
    },
    "enabledPlugins": {
        "claude-md-management@claude-plugins-official": true
    },
    "teammateMode": "tmux",
    "effortLevel": "high",
    "attribution": {
        "commit": "",
        "pr": ""
    }
}
